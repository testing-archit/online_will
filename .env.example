# --- AI (Gemini) -----------------------------------------------------------
GEMINI_API_KEY=replace_with_rotated_key
GEMINI_MODEL=gemini-3.6-flash
# Tried in order when the model above is overloaded, rate limited or slow (comma-separated).
# GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest
# Live voice (English, real time). Uses the same GEMINI_API_KEY; the browser only ever gets a single-use token.
# GEMINI_LIVE_MODEL=gemini-3.8-live            # or gemini-3.8-live-extended-thinking for deeper reasoning (slower)
# GEMINI_LIVE_VOICE=Aoede

# --- Speech (Deepgram) -----------------------------------------------------
# Server-side only. Powers Samaira's English voice (Aura-2) and listening in English,
# Hindi and Hinglish (Nova-3). Without it, voice falls back to the browser.
DEEPGRAM_API_KEY=replace_with_rotated_key
DEEPGRAM_TTS_MODEL=aura-2-thalia-en

# --- Hindi / Hinglish voice (Smallest.ai) ----------------------------------
# Server-side only (never a VITE_* variable). Voices Samaira's Hindi and Hinglish replies
# (Lightning v3.1 Pro). Without it those replies fall back to the browser voice.
SMALLEST_API_KEY=replace_with_rotated_key
SMALLEST_TTS_VOICE=meher
SMALLEST_TTS_SPEED=0.95
# In-memory audio cache (MB) for repeated lines; 0 disables it. Never written to disk.
SMALLEST_TTS_CACHE_MB=64

# --- Email / SMS (Brevo) ---------------------------------------------------
BREVO_API_KEY=replace_with_rotated_key
BREVO_SENDER_EMAIL=no-reply@example.com
BREVO_SENDER_NAME=Octaraa
BREVO_SMS_SENDER=Octaraa
# Internal notification audiences (comma-separated). Without these, advisor /
# lawyer / operations notifications are skipped — they are never sent to the client.
ADVISOR_EMAIL=
LAWYER_EMAIL=
OPERATIONS_EMAIL=

# --- API server ------------------------------------------------------------
API_PORT=8787
API_HOST=127.0.0.1
# Extra allowed browser origins (comma-separated). localhost/127.0.0.1 on 5173 and 4173 are always allowed.
CORS_ORIGIN=
# Set AUTH_REQUIRED=true to require signed session tokens. Then API_SESSION_SECRET
# must be a random string of 32+ characters (the server refuses to start otherwise).
AUTH_REQUIRED=false
API_SESSION_SECRET=replace_with_long_random_secret_of_32_plus_chars
# /api/auth/dev-login is disabled when NODE_ENV=production or ALLOW_DEV_LOGIN=false.
ALLOW_DEV_LOGIN=true
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_MS=60000
MAX_UPLOAD_BYTES=209715200
MAX_BODY_BYTES=41943040
LOCAL_DATA_DIR=.local-data
LOCAL_UPLOAD_DIR=.local-uploads

# --- Front end (Vite) ------------------------------------------------------
# Defaults to the app's own host on port 8787. Never put provider keys in VITE_* variables.
# VITE_API_BASE_URL=https://api.example.com
