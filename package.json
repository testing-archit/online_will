{
  "name": "online_wills",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "create-admin": "node --env-file-if-exists=.env.local scripts/create-admin.mjs",
    "build": "next build && cp -r public .next/standalone/ && cp -r .next/static .next/standalone/.next/ && cp -r database .next/standalone/",
    "lint": "oxlint",
    "start": "node --env-file-if-exists=.env.local .next/standalone/server.js",
    "test": "npm run test:client && npm run test:server",
    "test:client": "vitest run",
    "test:server": "node --test server/server.test.mjs"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.9.0",
    "@sentry/node": "^10.75.2",
    "@tailwindcss/postcss": "^4.3.3",
    "framer-motion": "^13.4.0",
    "lucide-react": "^1.47.0",
    "next": "^16.3.6",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.88.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "autoprefixer": "^10.6.1",
    "jsdom": "^29.1.1",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^3.2.7"
  }
}
