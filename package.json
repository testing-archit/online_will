{
  "name": "online_wills",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "api": "node --env-file-if-exists=.env.local server/server.mjs",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
